{
    "model_name": "PDFormer",
    "notes": "Merged Config: Original PDFormer Arch + B-MTGNN Settings",
    
    "task": "traffic_state_pred",
    "dataset": "Cyber_Threat",
    
    "input_window": 10,
    "output_window": 36,
    "train_rate": 0.43,
    "eval_rate": 0.30,
    "batch_size": 16,
    
    "embed_dim": 64,
    "skip_dim": 256,
    "lape_dim": 8,
    "geo_num_heads": 4,
    "sem_num_heads": 2,
    "t_num_heads": 2,
    "mlp_ratio": 4,
    "qkv_bias": true,
    
    "enc_depth": 2,
    "type_ln": "post",
    "type_short_path": "hop",
    
    "drop": 0.2,
    "attn_drop": 0.2,
    "drop_path": 0.2,
    
    "far_mask_delta": 2,
    "dtw_delta": 2,
    "s_attn_size": 3,
    "t_attn_size": 1,
    
    "learner": "adamw",
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "max_epoch": 100,
    
    "use_curriculum_learning": true,
    "step_size": 100,
    "task_level": 0,
    
    "load_external": false,
    "normal_external": false,
    "gpu": true,
    "gpu_id": 0,
    "num_workers": 0,
    "seed": 42
}